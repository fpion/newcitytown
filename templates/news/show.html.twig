{% extends 'base.html.twig' %}

{% block title %}{{ news.title }} - News{% endblock %}

{% block body %}
<div style="max-width: 800px; margin: 2rem auto; padding: 0 1rem; font-family: system-ui, sans-serif;">
    <a href="{{ path('news_index') }}" style="color: #2563eb; text-decoration: none; font-size: 0.875rem;">&larr; Back to list</a>

    {% for flash in app.flashes('success') %}
        <div style="background: #dcfce7; border: 1px solid #86efac; padding: 0.75rem 1rem; border-radius: 6px; margin: 1rem 0; color: #166534;">
            {{ flash }}
        </div>
    {% endfor %}

    {% for flash in app.flashes('error') %}
        <div style="background: #fee2e2; border: 1px solid #fca5a5; padding: 0.75rem 1rem; border-radius: 6px; margin: 1rem 0; color: #991b1b;">
            {{ flash }}
        </div>
    {% endfor %}

    <article style="margin-top: 1.5rem;">
        <header style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.5rem;">
            <div>
                <h1 style="margin: 0 0 0.5rem;">{{ news.title }}</h1>
                <time style="color: #6b7280; font-size: 0.875rem;">
                    Created on {{ news.createdAt|date('d/m/Y H:i') }}
                </time>
                {% if news.published and news.publishedAt %}
                    <span style="color: #6b7280; font-size: 0.875rem;">
                        &mdash; Published on {{ news.publishedAt|date('d/m/Y H:i') }}
                    </span>
                {% endif %}
            </div>
            <div style="display: flex; gap: 0.5rem; align-items: center;">
                {% if news.private %}
                    <span style="background: #f3f4f6; color: #6b7280; padding: 0.25rem 0.75rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 600;">
                        Privé
                    </span>
                {% else %}
                    <span style="background: #dbeafe; color: #1d4ed8; padding: 0.25rem 0.75rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 600;">
                        Public
                    </span>
                {% endif %}
                {% if news.published %}
                    <span style="background: #dcfce7; color: #166534; padding: 0.25rem 0.75rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 600;">
                        Published
                    </span>
                {% else %}
                    <span style="background: #fef3c7; color: #92400e; padding: 0.25rem 0.75rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 600;">
                        Draft
                    </span>
                {% endif %}
            </div>
        </header>

        <div style="border-top: 1px solid #e5e7eb; padding-top: 1.5rem; margin-top: 1.5rem; display: flex; gap: 1rem; flex-wrap: wrap;">
            {% if news.private %}
                <form method="POST" action="{{ path('news_visibility', { id: news.id }) }}">
                    <input type="hidden" name="private" value="0">
                    <button type="submit"
                            style="background: #2563eb; color: white; padding: 0.5rem 1.5rem; border: none; border-radius: 6px; cursor: pointer; font-size: 0.875rem; font-weight: 600;">
                        Rendre public
                    </button>
                </form>
            {% else %}
                <form method="POST" action="{{ path('news_visibility', { id: news.id }) }}">
                    <input type="hidden" name="private" value="1">
                    <button type="submit"
                            style="background: #6b7280; color: white; padding: 0.5rem 1.5rem; border: none; border-radius: 6px; cursor: pointer; font-size: 0.875rem; font-weight: 600;">
                        Rendre privé
                    </button>
                </form>
            {% endif %}
            {% if not news.published %}
                <form method="POST" action="{{ path('news_publish', { id: news.id }) }}">
                    <button type="submit"
                            style="background: #16a34a; color: white; padding: 0.5rem 1.5rem; border: none; border-radius: 6px; cursor: pointer; font-size: 0.875rem; font-weight: 600;"
                            onclick="return confirm('Are you sure you want to publish this news?')">
                        Publish this news
                    </button>
                </form>
            {% endif %}
        </div>
    </article>
</div>
{% endblock %}
